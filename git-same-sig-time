#############################################################################

# Verify faketime is installed
if ! command -v faketime &> /dev/null
then
    echo "'faketime' could not be found. Please install it first."
    echo "  Ubuntu/Debian: sudo apt-get install faketime"
    echo "  macOS: brew install libfaketime"
    exit 1
fi

git pretty -1 > /dev/null 2>&1
if [ "$?" -eq 1 ]; then
    echo "Error: You need \`git pretty\` installed. Add this to your ~/.gitconfig:"
    echo ""
    echo "    [pretty]"
    echo "      shortlog = format:%C(auto,yellow)%h%C(auto,magenta)% G? %Cred%ad %C(auto,green)%<(20,trunc)%aN%C(auto,reset)%s%C(auto,red)% gD% D"
    exit 1
fi

# Check if the target commit is the root commit
TARGET_COMMIT="$1"
PARENT_COMMIT="${TARGET_COMMIT}^"

# Test if parent exists (returns error for root commit)
if git rev-parse --verify "$PARENT_COMMIT" >/dev/null 2>&1; then
    # Not a root commit: use standard rebase range
    IS_ROOT=false
    COMMIT_COUNT=$(git log --oneline "$PARENT_COMMIT".. | wc -l)
    REBASE_BASE="$PARENT_COMMIT"
else
    # Root commit: need special handling
    IS_ROOT=true
    COMMIT_COUNT=$(git log --oneline | wc -l)
    echo "Detected root commit. Using --root rebase strategy."
fi

echo "Commit count: $COMMIT_COUNT"

# Perform interactive rebase with appropriate base
if [ "$IS_ROOT" = true ]; then
    GIT_SEQUENCE_EDITOR="sed -i -re 's/^pick/edit/'" git rebase -i --root
else
    GIT_SEQUENCE_EDITOR="sed -i -re 's/^pick/edit/'" git rebase -i "$REBASE_BASE"
fi

# Amend each commit with faketime matching the commit's original time
for a in $(eval echo {1.."$COMMIT_COUNT"}); do
    faketime "$(git pretty -1 | awk '{print $3" "$4" "$5}')" git commit --amend -S --no-edit
    git rebase --continue
done