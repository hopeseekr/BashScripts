# disable-nvidia - Enhanced script to manage NVIDIA GPU power on Linux
# Author: Original script enhanced with Wayland support, modern tools, and better diagnostics.
# Usage: ./disable-nvidia.sh

set -euo pipefail # Stricter error handling: exit on errors, unset vars, pipe failures

# --- Script Configuration & Colors ---
# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Emojis for clarity
ICON_INFO="💡"
ICON_SUCCESS="✅"
ICON_WARN="⚠️"
ICON_ERROR="❌"
ICON_ROCKET="🚀"
ICON_LEGACY="💾"
ICON_TOOL="🔧"
ICON_DANGER="💀"

# Logging file
LOG_FILE="/tmp/nvidia-power-log.txt"

# --- System Information (Gathered once, cached) ---
SESSION_TYPE=""
SUDO="sudo"
PKG_MANAGER=""
INSTALLCMD=""
NVIDIA_GPU_INFO=""
NVIDIA_DRIVER_VERSION=""
IGPU_VENDOR=""

# --- Helper Functions ---
print_info() { echo -e "${BLUE}${BOLD}${ICON_INFO} [INFO]${NC} $1" | tee -a "$LOG_FILE"; }
print_success() { echo -e "${GREEN}${BOLD}${ICON_SUCCESS} [SUCCESS]${NC} $1" | tee -a "$LOG_FILE"; }
print_warning() { echo -e "${YELLOW}${BOLD}${ICON_WARN} [WARNING]${NC} $1" | tee -a "$LOG_FILE"; }
print_error() { echo -e "${RED}${BOLD}${ICON_ERROR} [ERROR]${NC} $1" | tee -a "$LOG_FILE"; }

check_root() {
    if [[ $EUID -eq 0 ]]; then
        print_error "This script should not be run as root. Use sudo when prompted."
        exit 1
    fi
}

# Detect package manager and install packages
install_package() {
    if [[ -z "$PKG_MANAGER" ]]; then
        print_error "Package manager not detected. Cannot install '$1'."
        return 1
    fi

    if [[ ! "$PKG_MANAGER" =~ ^(pacman|paru|yay)$ ]] && [[ "$1" == "supergfxctl" || "$1" == "acpi_call-dkms" ]]; then
        print_warning "This package is AUR-specific. Manual installation may be needed on your distro."
        return 1
    fi

    print_info "Attempting to install '$1' using '$PKG_MANAGER'..."
    if ! $SUDO "$PKG_MANAGER" $INSTALLCMD "$1"; then
        print_error "Failed to install '$1'. Please install it manually."
        return 1
    fi
    print_success "Package '$1' installed successfully."
}

is_installed() {
    case "$PKG_MANAGER" in
        pacman|paru|yay) pacman -Q "$1" &>/dev/null ;;
        apt) dpkg -l "$1" &>/dev/null ;;
        dnf) dnf list installed "$1" &>/dev/null ;;
        zypper) zypper search -i "$1" &>/dev/null ;;
        emerge) emerge -s "$1" &>/dev/null ;;
        *) command -v "$1" &>/dev/null ;; # Fallback
    esac
}

get_system_info() {
    print_info "Gathering system information..."
    SESSION_TYPE=${XDG_SESSION_TYPE:-"unknown"}
    NVIDIA_GPU_INFO=$(lspci -d 10de: | grep -E "VGA|3D" | head -n1)
    NVIDIA_DRIVER_VERSION=$(cat /proc/driver/nvidia/version 2>/dev/null | grep "NVRM version" | awk '{print $8}' || echo "Not Found")

    # Detect iGPU vendor
    if lspci -d 8086: | grep -q "VGA"; then
        IGPU_VENDOR="Intel"
    elif lspci -d 1002: | grep -q "VGA"; then
        IGPU_VENDOR="AMD"
    else
        IGPU_VENDOR="Unknown"
    fi

    if   command -v paru &>/dev/null;   then PKG_MANAGER="paru"; SUDO=""; INSTALLCMD="-S --noconfirm";
    elif command -v yay &>/dev/null;    then PKG_MANAGER="yay"; SUDO=""; INSTALLCMD="-S --noconfirm";
    elif command -v pacman &>/dev/null; then PKG_MANAGER="pacman"; INSTALLCMD="-S --noconfirm";
    elif command -v apt &>/dev/null;    then PKG_MANAGER="apt"; INSTALLCMD="install -y";
    elif command -v dnf &>/dev/null;    then PKG_MANAGER="dnf"; INSTALLCMD="install -y";
    elif command -v zypper &>/dev/null; then PKG_MANAGER="zypper"; INSTALLCMD="install -y --no-confirm";
    elif command -v emerge &>/dev/null; then PKG_MANAGER="emerge"; INSTALLCMD="--ask=n";
    else PKG_MANAGER=""
    fi

    if [[ "$NVIDIA_DRIVER_VERSION" == "Not Found" ]]; then
        print_warning "NVIDIA drivers not detected. Install them? (e.g., 'nvidia' package)"
        read -rp "(y/N) " install_choice
        if [[ "$install_choice" =~ ^[Yy]$ ]]; then install_package "nvidia"; fi
    # elif [[ "${NVIDIA_DRIVER_VERSION%%.*}" -lt 470 ]]; then
    #     print_warning "Driver version $NVIDIA_DRIVER_VERSION is old. Update to 470+ for better RTD3 support."
    fi
}

prompt_reboot() {
    read -rp "Reboot now? (y/N) " choice
    if [[ "$choice" =~ ^[Yy]$ ]]; then
        systemctl reboot
    fi
}

# --- Power Management Methods ---

# Method 0: The Modern Way for Wayland & X11
nvidia_d3_pm_method() {
    print_info "${ICON_ROCKET} Setting up NVIDIA Runtime D3 Power Management (Modern Method)"
    print_info "This is the PREFERRED method for modern laptops (Turing/20xx series or newer)."
    print_info "It allows the GPU to automatically enter a deep power-saving state (D3cold) when unused."

    print_info "Creating /etc/modprobe.d/nvidia-power-management.conf..."
    echo 'options nvidia "NVreg_DynamicPowerManagement=0x02"' | sudo tee /etc/modprobe.d/nvidia-power-management.conf > /dev/null

    print_info "Creating /etc/udev/rules.d/80-nvidia-pm.rules..."
    sudo tee /etc/udev/rules.d/80-nvidia-pm.rules > /dev/null << 'EOF'
# Enable runtime PM for NVIDIA an on driver bind
ACTION=="bind", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{class}=="0x030000", TEST=="power/control", ATTR{power/control}="auto"
ACTION=="bind", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{class}=="0x030200", TEST=="power/control", ATTR{power/control}="auto"

# Disable runtime PM for NVIDIA on driver unbind
ACTION=="unbind", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{class}=="0x030000", TEST=="power/control", ATTR{power/control}="on"
ACTION=="unbind", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{class}=="0x030200", TEST=="power/control", ATTR{power/control}="on"
EOF

    print_info "Reloading udev rules and rebuilding initramfs (recommended)..."
    sudo udevadm control --reload-rules
    # Rebuilding initramfs ensures modprobe options are loaded early
    if command -v mkinitcpio &>/dev/null; then
        sudo mkinitcpio -P
    elif command -v dracut &>/dev/null; then
        sudo dracut --force
    else
        print_warning "Could not detect initramfs generator. Please run 'sudo mkinitcpio -P' or 'sudo dracut --force' manually."
    fi

    print_success "NVIDIA Runtime D3 Power Management has been configured."
    echo
    print_warning "${ICON_WARN} A REBOOT IS REQUIRED for these changes to take full effect."
    prompt_reboot
}

# Revert RTD3
revert_d3_pm() {
    print_info "Reverting NVIDIA Runtime D3 Power Management..."
    sudo rm -f /etc/modprobe.d/nvidia-power-management.conf /etc/udev/rules.d/80-nvidia-pm.rules
    sudo udevadm control --reload-rules
    print_success "Reverted. Reboot to apply."
    prompt_reboot
}

# Method 1: supergfxctl (renumbered for logical order)
supergfxctl_method() {
    print_info "Configuring with supergfxctl..."
    print_info "This is a great modern tool, especially for ASUS laptops and Wayland users. Note: It's ASUS-focused."

    # Install supergfxctl if not present
    if ! is_installed "supergfxctl"; then
        install_package "supergfxctl" || return 1
    fi

    # Enable and start service
    if ! sudo systemctl enable --now supergfxd.service; then
        print_error "Failed to enable supergfxd service"
        return 1
    fi

    # Show available modes
    local available_modes="$(sudo supergfxctl -s | tr -d '[]')"
    print_info "Available modes: $available_modes"
    IFS=', ' read -r -a mode_array <<< "$available_modes"
    PS3="Select GPU mode (enter number): "
    select target_mode in "${mode_array[@]}"; do
        if [[ -n "$target_mode" ]]; then
            break
        else
            print_error "Invalid option"
            return 1
        fi
    done

    # Switch mode
    print_info "Switching to '$target_mode' mode..."
    if sudo supergfxctl -m "$target_mode"; then
        print_success "Successfully switched to $target_mode mode."
        print_warning "A reboot is required to apply the new mode."
        prompt_reboot
    else
        print_error "Failed to switch to $target_mode mode."
        return 1
    fi
}

# Revert supergfxctl
revert_supergfxctl() {
    print_info "Reverting supergfxctl to hybrid mode..."
    sudo supergfxctl -m hybrid
    print_success "Reverted to hybrid. Reboot to apply."
    prompt_reboot
}

# Method 2: envycontrol
envycontrol_method() {
    print_info "Configuring with envycontrol..."
    print_info "A simple tool to switch graphics modes by managing system configuration files."
    print_info "GitHub: https://github.com/bayasdev/envycontrol"

    if ! command -v envycontrol &>/dev/null; then
        print_info "envycontrol is a Python tool. Attempting pip install..."
        if ! pip install --user envycontrol; then
            print_error "Pip install failed. Ensure Python and pip are installed."
            return 1
        fi
    fi

    print_info "Available modes: integrated, hybrid, nvidia"
    read -p "Enter desired mode [hybrid]: " mode
    mode=${mode:-hybrid}

    if sudo envycontrol -s "$mode"; then
        print_success "Mode set to '$mode'. A REBOOT IS REQUIRED."
        prompt_reboot
    else
        print_error "Failed to set mode with envycontrol."
    fi
}

# Revert envycontrol
revert_envycontrol() {
    print_info "Reverting envycontrol to hybrid mode..."
    sudo envycontrol -s hybrid
    print_success "Reverted. Reboot to apply."
    prompt_reboot
}

# Method 3: Optimus Manager
optimus_manager_method() {
    print_info "Configuring with optimus-manager..."
    if [[ "$SESSION_TYPE" == "wayland" ]]; then
        print_warning "Optimus Manager has limited functionality on Wayland."
        print_warning "You can only use 'hybrid' mode. The goal is to let the GPU sleep via D3 PM."
        print_warning "'integrated' mode will not work and may break your session."
    fi

    if [[ "$IGPU_VENDOR" == "AMD" ]]; then
        print_warning "Optimus Manager does not support AMD iGPUs."
    fi

    if ! is_installed "optimus-manager"; then
        install_package "optimus-manager" || return 1
    fi

    print_info "Switching to 'hybrid' mode (recommended for compatibility)..."
    if sudo optimus-manager --switch hybrid; then
      print_success "Switched to hybrid mode. The dGPU will be available for on-demand offloading."
      print_warning "You need to log out and log back in (or reboot) for changes to take effect."
      prompt_reboot
    else
      print_error "Failed to switch mode. Check 'optimus-manager' logs."
    fi
}

# Revert optimus-manager
revert_optimus_manager() {
    print_info "Reverting optimus-manager to hybrid mode..."
    sudo optimus-manager --switch hybrid
    print_success "Reverted. Reboot to apply."
    prompt_reboot
}

# Method 4: bbswitch (Legacy)
bbswitch_method() {
    print_warning "${ICON_LEGACY} Using bbswitch (Legacy Method)..."
    print_warning "This is an older method and may not work on newer GPUs (Turing+) or AMD systems."
    print_warning "Runtime D3 PM (Method 0) is strongly preferred."

    read -rp "Proceed anyway? (y/N) " choice
    if ! [[ "$choice" =~ ^[Yy]$ ]]; then return; fi

    if ! is_installed "bbswitch"; then install_package "bbswitch" || return 1; fi
    sudo modprobe bbswitch

    print_info "Attempting to turn off NVIDIA GPU via bbswitch..."
    echo OFF | sudo tee /proc/acpi/bbswitch > /dev/null

    if grep -q "OFF" /proc/acpi/bbswitch; then
        print_success "NVIDIA GPU successfully turned OFF using bbswitch."
    else
        print_error "Failed to turn off NVIDIA GPU using bbswitch. It may not be supported."
    fi
}

# Method 5: acpi_call (Manual Power On/Off)
turn_gpu_off_acpi() {
    local nvidia_pci_busid=$(lspci -d 10de: | grep -E "(VGA|3D)" | head -n1 | cut -d' ' -f1)
    if [ -z "$nvidia_pci_busid" ]; then
        print_error "Could not find NVIDIA PCI bus ID. Cannot proceed."
        return 1
    fi

    print_info "Found NVIDIA GPU at PCI bus ID: $nvidia_pci_busid"
    print_info "Attempting to unbind driver from GPU..."
    # Unbind both graphics and audio device if they exist
    echo "$nvidia_pci_busid" | sudo tee /sys/bus/pci/drivers/nvidia/unbind >/dev/null 2>&1 || print_warning "Could not unbind main GPU device (maybe not bound)."

    local audio_device_busid=$(lspci | grep -i "NVIDIA Corporation.*Audio Device" | cut -d' ' -f1)
    if [ -n "$audio_device_busid" ]; then
        echo "$audio_device_busid" | sudo tee /sys/bus/pci/drivers/snd_hda_intel/unbind >/dev/null 2>&1 || print_warning "Could not unbind GPU audio device."
    fi

    print_info "Sending ACPI command to turn GPU OFF..."
    # This is a common ACPI call, but it can vary by machine
    echo '\_SB.PCI0.PEG0.PEGP._OFF' | sudo tee /proc/acpi/call > /dev/null
    print_warning "Note: If this fails, your hardware might require a different ACPI call (e.g., search forums for your laptop model)."

    # Verification
    sleep 2 # Give system time to react
    if ! lspci -d 10de: | grep -q 'NVIDIA'; then
        print_success "NVIDIA GPU appears to be turned OFF."
        print_info "It has been removed from lspci listing as expected."
        print_info "Check power draw with nvidia-smi if driver is loaded."
    else
        print_error "Failed to turn off GPU. It is still visible in lspci."
        print_warning "Your hardware might require a different ACPI call."
    fi
}

turn_gpu_on_acpi() {
    print_info "Sending ACPI command to turn GPU ON..."
    # This is a common ACPI call, but it can vary by machine
    echo '\_SB.PCI0.PEG0.PEGP._ON' | sudo tee /proc/acpi/call > /dev/null

    print_info "Requesting PCI bus rescan..."
    echo 1 | sudo tee /sys/bus/pci/rescan > /dev/null

    # Verification
    sleep 2 # Give rescan time to work
    if lspci -d 10de: | grep -q 'NVIDIA'; then
        print_success "NVIDIA GPU appears to be turned ON and is visible in lspci."
        print_warning "You may need to manually reload the nvidia drivers or reboot to use it."
        print_info "Try: sudo modprobe nvidia"
    else
        print_error "Failed to turn on GPU. It is still not visible in lspci."
        print_warning "A full reboot is likely required to restore the GPU."
    fi
}

acpi_call_install_module() {
    # Check if acpi_call module is already loaded
    if lsmod | awk '$1 == "acpi_call"' >/dev/null; then
        return 0
    fi

    # Attempt to load module directly (checks both existence and loadability)
    if sudo modprobe -q acpi_call 2>/dev/null; then
        return 0
    fi

    # Determine appropriate package based on package manager
    if [[ "$PKG_MANAGER" =~ ^(pacman|paru|yay)$ ]]; then
        PKG_NAME="acpi_call-dkms"
    else
        PKG_NAME="acpi_call"
    fi

    # Verify package installation status
    if ! is_installed "$PKG_NAME"; then
        read -rp "The 'acpi_call' kernel module is not installed. Install it now? (y/N) " choice
        if [[ "$choice" =~ ^[Yy]$ ]]; then
            install_package "$PKG_NAME" || { print_error "Failed to install $PKG_NAME"; return 1; }
        else
            print_error "acpi_call is required for this functionality"
            return 1
        fi
    fi

    # Final attempt to load module after installation
    if ! sudo modprobe -q acpi_call; then
        print_error "Module installed but failed to load acpi_call"
        print_error "Try rebooting or checking kernel module compatibility"
        return 1
    fi
}

acpi_call_method() {
    print_warning "${ICON_DANGER} Using acpi_call (Manual Power Toggle)"
    print_warning "This is a low-level method that directly tells the firmware to cut or restore"
    print_warning "power to the GPU. It can be unstable and is highly specific to your laptop model."
    print_warning "If this fails, a full reboot is the only guaranteed way to fix it."
    echo

    read -rp "Proceed? (y/N) " choice1
    if [[ "$choice1" =~ ^[Yy]$ ]]; then
        read -rp "Confirm again: This could break your GPU until reboot. (y/N) " choice2
        if ! [[ "$choice2" =~ ^[Yy]$ ]]; then return; fi
    else
        return
    fi

    acpi_call_install_module || return 1

    # Check if GPU is currently on or off
    if lspci -d 10de: | grep -q 'NVIDIA'; then
        print_info "NVIDIA GPU is currently ON (visible in lspci)."
        read -rp "Do you want to attempt to turn it OFF? (y/N) " choice
        if [[ "$choice" =~ ^[Yy]$ ]]; then
            turn_gpu_off_acpi
        fi
    else
        print_info "NVIDIA GPU is currently OFF (not visible in lspci)."
        read -rp "Do you want to attempt to turn it ON? (y/N) " choice
        if [[ "$choice" =~ ^[Yy]$ ]]; then
            turn_gpu_on_acpi
        fi
    fi
}

# New: PRIME offload setup
prime_offload_setup() {
    print_info "Setting up PRIME offload alias for easy dGPU use in hybrid modes."
    echo 'alias nvidia-run="__NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia"' >> ~/.bashrc
    print_success "Added 'nvidia-run' alias to ~/.bashrc. Use: nvidia-run <app>"
    print_info "Source your .bashrc or restart terminal to use."
}

# New: Monitor power
monitor_power() {
    print_info "Monitoring GPU power draw every 5 seconds (Ctrl+C to stop)..."
    while true; do
        nvidia-smi -q -d power | grep "Power Draw" || print_error "nvidia-smi failed. Is the driver loaded?"
        sleep 5
    done
}

# New: prime-run method (simple offloading)
prime_run_method() {
    print_info "PRIME-run is a simple way for on-demand NVIDIA usage without switching modes."
    print_info "It requires NVIDIA drivers and PRIME setup (often included in distros like Ubuntu)."
    print_info "Usage: prime-run <application> to run on dGPU."
    print_info "No installation needed if drivers are set up."
    print_warning "This is for hybrid modes only; ensure RTD3 is enabled for power savings."
}

# --- Diagnostics and Info ---

# Display Wayland-specific information
wayland_explanation() {
    echo -e "${PURPLE}${BOLD}--- How NVIDIA Power Management Works on Wayland ---${NC}"
    echo
    echo -e "On ${BOLD}Wayland${NC}, you can't truly 'switch' to an integrated-only mode like on X11."
    echo -e "Your system always runs in a ${BOLD}hybrid mode${NC}, where both GPUs are available."
    echo
    echo -e "The goal is ${BOLD}NOT${NC} to disable the NVIDIA driver, but to make the physical GPU"
    echo -e "go into a deep sleep state (${BOLD}D3cold${NC}) when it's not being used for an application."
    echo
    echo -e "${GREEN}${BOLD}Your Action Plan:${NC}"
    echo -e "1. Use ${BOLD}Method 0 (${ICON_ROCKET})${NC} to enable Runtime D3 Power Management. This is essential."
    echo -e "2. Use a tool like ${BOLD}supergfxctl${NC} (Method 1) and set it to 'hybrid' mode."
    echo -e "3. After rebooting, use the ${BOLD}Status Check${NC} (Method 9) to verify power management is 'active'."
    echo
    echo -e "When an app needs the dGPU, you launch it like this:"
    echo -e "${YELLOW}__NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia <application>${NC}"
    echo
}

check_status() {
    print_info "${ICON_TOOL} Checking current GPU and power status..."
    # Refresh GPU info in case we just turned it on
    NVIDIA_GPU_INFO=$(lspci -d 10de: -m | grep -E "VGA|3D" | head -n1 | cut -d '"' -f 2,4,6 --output-delimiter=' ' || echo "")
    local nvidia_pci_busid=$(lspci -d 10de: | grep -E "(VGA|3D)" | head -n1 | cut -d' ' -f1)

    echo -e "\n${PURPLE}--- System ---${NC}"
    echo -e "Session Type:          ${BOLD}$SESSION_TYPE${NC}"
    echo -e "Package Manager:       ${BOLD}${PKG_MANAGER:-Not Found}${NC}"
    echo -e "iGPU Vendor:           ${BOLD}$IGPU_VENDOR${NC}"

    echo -e "\n${PURPLE}--- NVIDIA Hardware & Driver ---${NC}"
    if [[ -z "$NVIDIA_GPU_INFO" ]]; then
        echo -e "GPU:                   ${RED}${BOLD}Not Found${NC} (Likely powered off via acpi_call)"
    else
        echo "GPU:                   ${BOLD}${NVIDIA_GPU_INFO}${NC}"
        echo "Driver Version:        ${BOLD}$NVIDIA_DRIVER_VERSION${NC}"
    fi

    if [[ -n "$nvidia_pci_busid" ]]; then
        local pci_path="/sys/bus/pci/devices/0000:${nvidia_pci_busid}"
        echo -e "\n${PURPLE}--- Runtime D3 Power Management Status ---${NC}"
        if [[ -f "${pci_path}/power/control" ]]; then
            local power_control_status=$(cat "${pci_path}/power/control")
            echo -e "Power Control:         ${BOLD}$power_control_status${NC}"
            if [[ "$power_control_status" == "auto" ]]; then
                print_success "Runtime PM is enabled."
                local runtime_status=$(cat "${pci_path}/power/runtime_status")
                echo -e "Runtime Status:        ${BOLD}$runtime_status${NC}"
                if [[ "$runtime_status" == "active" ]]; then
                    print_warning "GPU is currently active (in use or not sleeping)."
                else
                    print_success "GPU is suspended (in a low-power state)."
                fi
            else
                print_error "Runtime PM is disabled. Use Method 0 to enable it."
            fi
        else
            print_warning "Could not read power control status. Is the driver loaded?"
        fi
    fi

    echo -e "\n${PURPLE}--- Helper Tool Status ---${NC}"
    echo -n "optimus-manager:       "; command -v optimus-manager &>/dev/null && optimus-manager --print-mode || echo "Not installed/configured"
    echo -n "supergfxctl:           "; command -v supergfxctl &>/dev/null && supergfxctl -g || echo "Not installed/configured"
    echo -n "envycontrol:           "; command -v envycontrol &>/dev/null && envycontrol -q || echo "Not installed"
    echo -n "bbswitch:              "; [[ -f /proc/acpi/bbswitch ]] && cat /proc/acpi/bbswitch || echo "Not available"
}

# Revert menu
revert_changes() {
    echo "Select method to revert:"
    echo "0) Revert Runtime D3 PM"
    echo "1) Revert supergfxctl"
    echo "2) Revert envycontrol"
    echo "3) Revert optimus-manager"
    read -p "Enter choice: " rev_choice
    case $rev_choice in
        0) revert_d3_pm ;;
        1) revert_supergfxctl ;;
        2) revert_envycontrol ;;
        3) revert_optimus_manager ;;
        *) print_error "Invalid option." ;;
    esac
}

# --- Main Menu & Script Execution ---

show_menu() {
    echo
    echo "========================================================"
    echo "        NVIDIA GPU Power Management Helper"
    echo "========================================================"
    echo -e "Detected Session: ${BOLD}${SESSION_TYPE}${NC} | GPU Driver: ${BOLD}${NVIDIA_DRIVER_VERSION}${NC}"
    if [[ "$SESSION_TYPE" == "wayland" ]]; then
        echo -e "${GREEN}Recommended: Option 0 (RTD3) + Option 1 (supergfxctl)${NC}"
        echo -e "${PURPLE}💡 You are on Wayland! For guidance, choose option 8.${NC}"
    fi
    if ! lspci -d 10de: | grep -q 'NVIDIA'; then
       echo -e "${RED}${BOLD}WARNING: NVIDIA GPU is not detected via lspci. It may be powered off.${NC}"
    fi
    echo "--------------------------------------------------------"
    echo "Choose an action:"
    echo
    echo -e "  ${PURPLE}--- Recommended Methods ---${NC}"
    echo -e "  ${BOLD}0)${NC} ${ICON_ROCKET} Enable NVIDIA Runtime D3 Power Management ${GREEN}(Modern, Recommended for ALL systems)${NC}"
    echo
    echo -e "  ${PURPLE}--- Graphics Switching Tools ---${NC}"
    echo -e "  ${BOLD}1)${NC} Configure with ${BOLD}supergfxctl${NC} (Good for Wayland/ASUS)"
    echo -e "  ${BOLD}2)${NC} Configure with ${BOLD}envycontrol${NC} (Simple config-based switcher)"
    echo -e "  ${BOLD}3)${NC} Configure with ${BOLD}optimus-manager${NC} (AMD not supported)"
    echo
    echo -e "  ${PURPLE}--- Legacy/Advanced Methods ---${NC}"
    echo -e "  ${BOLD}4)${NC} ${ICON_LEGACY} Use ${BOLD}bbswitch${NC} to force power off (Older GPUs only)"
    echo -e "  ${BOLD}5)${NC} ${ICON_DANGER} Toggle GPU Power via ${BOLD}acpi_call${NC} ${YELLOW}(Manual ON/OFF - Advanced)${NC}"
    echo
    echo -e "  ${PURPLE}--- Additional Features ---${NC}"
    echo -e "  ${BOLD}6)${NC} Setup PRIME offload alias (for hybrid on-demand)"
    echo -e "  ${BOLD}7)${NC} Explain PRIME-run (simple on-demand usage)"
    echo -e "  ${BOLD}M)${NC} Monitor GPU Power Draw"
    echo
    echo -e "  ${PURPLE}--- Diagnostics & Information ---${NC}"
    echo -e "  ${BOLD}8)${NC} ${ICON_INFO} Explain how NVIDIA power management works on ${BOLD}Wayland${NC}"
    echo -e "  ${BOLD}9)${NC} ${ICON_TOOL} Full System & GPU Power Status Check"
    echo
    echo -e "  ${BOLD}R)${NC} Revert Changes"
    echo -e "  ${BOLD}q)${NC} Exit"
    echo
}

use_dialog_menu() {
    # If dialog is installed, use it for TUI
    if command -v dialog &>/dev/null; then
        choices=$(dialog --menu "NVIDIA GPU Power Management Helper" 0 0 0 \
            0 "Enable NVIDIA Runtime D3 Power Management (Modern)" \
            1 "Configure with supergfxctl (Wayland/ASUS)" \
            2 "Configure with envycontrol (Simple)" \
            3 "Configure with optimus-manager" \
            4 "Use bbswitch (Legacy)" \
            5 "Toggle GPU Power via acpi_call (Advanced)" \
            6 "Setup PRIME offload alias" \
            7 "Explain PRIME-run" \
            M "Monitor GPU Power Draw" \
            8 "Explain Wayland NVIDIA PM" \
            9 "System & GPU Status Check" \
            R "Revert Changes" \
            q "Exit" 3>&1 1>&2 2>&3)
        echo "$choices"
    else
        return 0
    fi
}

main() {
    check_root
    get_system_info
    > "$LOG_FILE" # Clear log file

    # Check for basic dependencies
    for dep in lspci tee; do
        if ! command -v "$dep" &>/dev/null; then
            print_warning "$dep not found. Installing..."
            install_package "$dep"
        fi
    done

    while true; do
        show_menu
        dialog_choice=$(use_dialog_menu)
        if [[ -n "$dialog_choice" ]]; then
            choice="$dialog_choice"
        else
            read -p "Enter your choice: " choice
        fi

        case $choice in
            0) nvidia_d3_pm_method ;;
            1) supergfxctl_method ;;
            2) envycontrol_method ;;
            3) optimus_manager_method ;;
            4) bbswitch_method ;;
            5) acpi_call_method ;;
            6) prime_offload_setup ;;
            7) prime_run_method ;;
            M|m) monitor_power ;;
            8) wayland_explanation ;;
            9) check_status ;;
            R|r) revert_changes ;;
            q|Q) print_info "Exiting... Log saved to $LOG_FILE"; exit 0 ;;
            *) print_error "Invalid option. Please choose from the menu." ;;
        esac

        echo
        read -p "Press Enter to return to the menu..."
    done
}

# Run main function
main
