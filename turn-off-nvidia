#!/bin/bash

# disable-nvidia - Enhanced script to manage NVIDIA GPU power on Linux
# Author: Original script enhanced with Wayland support, modern tools, and better diagnostics.
# Usage: ./disable-nvidia.sh

set -e # Exit on any error

# --- Script Configuration & Colors ---
# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Emojis for clarity
ICON_INFO="💡"
ICON_SUCCESS="✅"
ICON_WARN="⚠️"
ICON_ERROR="❌"
ICON_ROCKET="🚀"
ICON_LEGACY="💾"
ICON_TOOL="🔧"

# --- System Information (Gathered once) ---
SESSION_TYPE=""
SUDO="sudo"
PKG_MANAGER=""
INSTALLCMD=""
NVIDIA_GPU_INFO=""
NVIDIA_DRIVER_VERSION=""

# --- Helper Functions ---
print_info() { echo -e "${BLUE}${BOLD}${ICON_INFO} [INFO]${NC} $1"; }
print_success() { echo -e "${GREEN}${BOLD}${ICON_SUCCESS} [SUCCESS]${NC} $1"; }
print_warning() { echo -e "${YELLOW}${BOLD}${ICON_WARN} [WARNING]${NC} $1"; }
print_error() { echo -e "${RED}${BOLD}${ICON_ERROR} [ERROR]${NC} $1"; }

check_root() {
    if [[ $EUID -eq 0 ]]; then
        print_error "This script should not be run as root. Use sudo when prompted."
        exit 1
    fi
}

# Detect package manager and install packages
install_package() {
    if [[ -z "$PKG_MANAGER" ]]; then
        print_error "Package manager not detected. Cannot install '$1'."
        return 1
    fi
    print_info "Attempting to install '$1' using '$PKG_MANAGER'..."
    if ! $SUDO "$PKG_MANAGER" $INSTALLCMD "$1"; then
        print_error "Failed to install '$1'. Please install it manually."
        return 1
    fi
    print_success "Package '$1' installed successfully."
}

is_installed() {
    case "$PKG_MANAGER" in
        pacman) pacman -Q "$1" &>/dev/null ;;
        apt) dpkg -l "$1" &>/dev/null ;;
        dnf) dnf list installed "$1" &>/dev/null ;;
        *) command -v "$1" &>/dev/null ;; # Fallback
    esac
}

get_system_info() {
    print_info "Gathering system information..."
    SESSION_TYPE=${XDG_SESSION_TYPE:-"unknown"}
    NVIDIA_GPU_INFO=$(lspci -d 10de: | grep -E "VGA|3D" | head -n1)
    NVIDIA_DRIVER_VERSION=$(cat /proc/driver/nvidia/version 2>/dev/null | grep "NVRM version" | awk '{print $8}' || echo "Not Found")

    if   command -v paru &>/dev/null;   then PKG_MANAGER="paru"; SUDO=""; INSTALLCMD="-S --noconfirm";
    elif command -v yay &>/dev/null;    then PKG_MANAGER="yay"; SUDO=""; INSTALLCMD="-S --noconfirm";
    elif command -v pacman &>/dev/null; then PKG_MANAGER="pacman"; INSTALLCMD="-S --noconfirm";
    elif command -v apt &>/dev/null;    then PKG_MANAGER="apt"; INSTALLCMD="install -y";
    elif command -v dnf &>/dev/null;    then PKG_MANAGER="dnf"; INSTALLCMD="install -y";
    else PKG_MANAGER=""
    fi
}

# --- Power Management Methods ---

# Method 0: The Modern Way for Wayland & X11
nvidia_d3_pm_method() {
    print_info "${ICON_ROCKET} Setting up NVIDIA Runtime D3 Power Management (Modern Method)"
    print_info "This is the PREFERRED method for modern laptops (Turing/20xx series or newer)."
    print_info "It allows the GPU to automatically enter a deep power-saving state (D3cold) when unused."

    print_info "Creating /etc/modprobe.d/nvidia-power-management.conf..."
    echo 'options nvidia "NVreg_DynamicPowerManagement=0x02"' | sudo tee /etc/modprobe.d/nvidia-power-management.conf > /dev/null

    print_info "Creating /etc/udev/rules.d/80-nvidia-pm.rules..."
    sudo tee /etc/udev/rules.d/80-nvidia-pm.rules > /dev/null << 'EOF'
# Enable runtime PM for NVIDIA an on driver bind
ACTION=="bind", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{class}=="0x030000", TEST=="power/control", ATTR{power/control}="auto"
ACTION=="bind", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{class}=="0x030200", TEST=="power/control", ATTR{power/control}="auto"

# Disable runtime PM for NVIDIA on driver unbind
ACTION=="unbind", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{class}=="0x030000", TEST=="power/control", ATTR{power/control}="on"
ACTION=="unbind", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{class}=="0x030200", TEST=="power/control", ATTR{power/control}="on"
EOF

    print_info "Reloading udev rules and rebuilding initramfs (recommended)..."
    sudo udevadm control --reload-rules
    # Rebuilding initramfs ensures modprobe options are loaded early
    if command -v mkinitcpio &>/dev/null; then
        sudo mkinitcpio -P
    elif command -v dracut &>/dev/null; then
        sudo dracut --force
    else
        print_warning "Could not detect initramfs generator. Please run 'sudo mkinitcpio -P' or 'sudo dracut --force' manually."
    fi

    print_success "NVIDIA Runtime D3 Power Management has been configured."
    echo
    print_warning "${ICON_WARN} A REBOOT IS REQUIRED for these changes to take full effect."
}

# Method 1: Optimus Manager
optimus_manager_method() {
    print_info "Configuring with optimus-manager..."
    if [[ "$SESSION_TYPE" == "wayland" ]]; then
        print_warning "Optimus Manager has limited functionality on Wayland."
        print_warning "You can only use 'hybrid' mode. The goal is to let the GPU sleep via D3 PM."
        print_warning "'integrated' mode will not work and may break your session."
    fi

    if ! is_installed "optimus-manager"; then
        install_package "optimus-manager" || return 1
    fi

    print_info "Switching to 'hybrid' mode (recommended for compatibility)..."
    if sudo optimus-manager --switch hybrid; then
      print_success "Switched to hybrid mode. The dGPU will be available for on-demand offloading."
      print_warning "You need to log out and log back in (or reboot) for changes to take effect."
    else
      print_error "Failed to switch mode. Check 'optimus-manager' logs."
    fi
}

# Method 2: supergfxctl
supergfxctl_method() {
    print_info "Configuring with supergfxctl..."
    print_info "This is a great modern tool, especially for ASUS laptops and Wayland users."

    # Install supergfxctl if not present
    if ! is_installed "supergfxctl"; then
        install_package "supergfxctl" || return 1
    fi

    # Enable and start service
    if ! sudo systemctl enable --now supergfxd.service; then
        print_error "Failed to enable supergfxd service"
        return 1
    fi

    # Show available modes
    local available_modes="$(sudo supergfxctl -s | tr -d '[]')"
    print_info "Available modes: $available_modes"

    # Prompt user for mode selection
    PS3="Select GPU mode (1-3): "
    select mode in "Integrated" "Hybrid" "NVIDIA-only (NvidiaNoModeset)"; do
        case $REPLY in
            1) target_mode="Integrated" ;;
            2) target_mode="Hybrid" ;;
            3) target_mode="NvidiaNoModeset" ;;
            *) print_error "Invalid option"; return 1 ;;
        esac
        break
    done

    # Switch mode
    print_info "Switching to '$target_mode' mode..."
    if sudo supergfxctl -m "$target_mode"; then
        print_success "Successfully switched to $target_mode mode."
        print_warning "A reboot is required to apply the new mode."

        # Ask user if they want to reboot now
        read -rp "Reboot now? (y/N) " choice
        if [[ "$choice" =~ ^[Yy]$ ]]; then
            systemctl reboot
        fi
    else
        print_error "Failed to switch to $target_mode mode."
        return 1
    fi
}

# Method 3: envycontrol
envycontrol_method() {
    print_info "Configuring with envycontrol..."
    print_info "A simple tool to switch graphics modes by managing system configuration files."

    if ! is_installed "envycontrol"; then
        # On Arch, it's often a git package from AUR, we'll try a common pip install
        install_package envycontrol || return 1

        if ! command -v optimus-manage >/dev/null; then
            if ! pip install envycontrol; then
                print_warning "Could not auto-install with pip. Please install 'envycontrol' manually."
                print_info "Try: pip install envycontrol"
                return 1
            fi
        fi
    fi

    print_info "Available modes: integrated, hybrid, nvidia"
    read -p "Enter desired mode [hybrid]: " mode
    mode=${mode:-hybrid}

    if sudo envycontrol -s "$mode"; then
        print_success "Mode set to '$mode'. A REBOOT IS REQUIRED."
    else
        print_error "Failed to set mode with envycontrol."
    fi
}

# Method 4: bbswitch (Legacy)
bbswitch_method() {
    print_warning "${ICON_LEGACY} Using bbswitch (Legacy Method)..."
    print_warning "This is an older method and may not work on newer GPUs (Turing+) or AMD systems."
    print_warning "Runtime D3 PM (Method 0) is strongly preferred."

    if ! is_installed "bbswitch"; then install_package "bbswitch" || return 1; fi
    sudo modprobe bbswitch

    print_info "Attempting to turn off NVIDIA GPU via bbswitch..."
    echo OFF | sudo tee /proc/acpi/bbswitch > /dev/null

    if grep -q "OFF" /proc/acpi/bbswitch; then
        print_success "NVIDIA GPU successfully turned OFF using bbswitch."
    else
        print_error "Failed to turn off NVIDIA GPU using bbswitch. It may not be supported."
    fi
}

# --- Diagnostics and Info ---

# Display Wayland-specific information
wayland_explanation() {
    echo -e "${PURPLE}${BOLD}--- How NVIDIA Power Management Works on Wayland ---${NC}"
    echo
    echo -e "On ${BOLD}Wayland${NC}, you can't truly 'switch' to an integrated-only mode like on X11."
    echo -e "Your system always runs in a ${BOLD}hybrid mode${NC}, where both GPUs are available."
    echo
    echo -e "The goal is ${BOLD}NOT${NC} to disable the NVIDIA driver, but to make the physical GPU"
    echo -e "go into a deep sleep state (${BOLD}D3cold${NC}) when it's not being used for an application."
    echo
    echo -e "${GREEN}${BOLD}Your Action Plan:${NC}"
    echo -e "1. Use ${BOLD}Method 0 (${ICON_ROCKET})${NC} to enable Runtime D3 Power Management. This is essential."
    echo -e "2. Use a tool like ${BOLD}supergfxctl${NC} (Method 2) and set it to 'hybrid' mode."
    echo -e "3. After rebooting, use the ${BOLD}Status Check${NC} (Method 9) to verify power management is 'active'."
    echo
    echo -e "When an app needs the dGPU, you launch it like this:"
    echo -e "${YELLOW}__NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia <application>${NC}"
    echo
}

check_status() {
    print_info "${ICON_TOOL} Checking current GPU and power status..."
    local nvidia_pci_busid=$(lspci -d 10de: | grep -E "(VGA|3D)" | head -n1 | cut -d' ' -f1)

    echo -e "\n${PURPLE}--- System ---${NC}"
    echo "Session Type:          ${BOLD}$SESSION_TYPE${NC}"
    echo "Package Manager:       ${BOLD}${PKG_MANAGER:-Not Found}${NC}"

    echo -e "\n${PURPLE}--- NVIDIA Hardware & Driver ---${NC}"
    echo "GPU:                   ${BOLD}${NVIDIA_GPU_INFO:-Not Found}${NC}"
    echo "Driver Version:        ${BOLD}$NVIDIA_DRIVER_VERSION${NC}"

    if [[ -n "$nvidia_pci_busid" ]]; then
        local pci_path="/sys/bus/pci/devices/0000:${nvidia_pci_busid}"
        echo -e "\n${PURPLE}--- Runtime D3 Power Management Status ---${NC}"
        if [[ -f "${pci_path}/power/control" ]]; then
            local power_control_status=$(cat "${pci_path}/power/control")
            echo -e "Power Control:         ${BOLD}$power_control_status${NC}"
            if [[ "$power_control_status" == "auto" ]]; then
                print_success "Runtime PM is enabled."
                local runtime_status=$(cat "${pci_path}/power/runtime_status")
                echo -e "Runtime Status:        ${BOLD}$runtime_status${NC}"
                if [[ "$runtime_status" == "active" ]]; then
                    print_warning "GPU is currently active (in use or not sleeping)."
                else
                    print_success "GPU is suspended (in a low-power state)."
                fi
            else
                print_error "Runtime PM is disabled. Use Method 0 to enable it."
            fi
        else
            print_warning "Could not read power control status. Is the driver loaded?"
        fi
    fi

    echo -e "\n${PURPLE}--- Helper Tool Status ---${NC}"
    echo -n "optimus-manager:       "; command -v optimus-manager &>/dev/null && optimus-manager --print-mode || echo "Not installed/configured"
    echo -n "supergfxctl:           "; command -v supergfxctl &>/dev/null && supergfxctl -S || echo "Not installed/configured"
    echo -n "envycontrol:           "; command -v envycontrol &>/dev/null && envycontrol -q || echo "Not installed/dev/null"
    echo -n "bbswitch:              "; [[ -f /proc/acpi/bbswitch ]] && cat /proc/acpi/bbswitch || echo "Not available"
}

# --- Main Menu & Script Execution ---

show_menu() {
    echo
    echo "========================================================"
    echo "        NVIDIA GPU Power Management Helper"
    echo "========================================================"
    echo -e "Detected Session: ${BOLD}${SESSION_TYPE}${NC} | GPU Driver: ${BOLD}${NVIDIA_DRIVER_VERSION}${NC}"
    if [[ "$SESSION_TYPE" == "wayland" ]]; then
        echo -e "${PURPLE}💡 You are on Wayland! For guidance, choose option 8.${NC}"
    fi
    echo "--------------------------------------------------------"
    echo "Choose an action:"
    echo
    echo -e "  ${PURPLE}--- Recommended Methods ---${NC}"
    echo -e "  ${BOLD}0)${NC} ${ICON_ROCKET} Enable NVIDIA Runtime D3 Power Management ${GREEN}(Modern, Recommended for ALL systems)${NC}"
    echo
    echo -e "  ${PURPLE}--- Graphics Switching Tools ---${NC}"
    echo -e "  ${BOLD}1)${NC} Configure with ${BOLD}supergfxctl${NC} (Good for Wayland/ASUS)"
    echo -e "  ${BOLD}2)${NC} Configure with ${BOLD}envycontrol${NC} (Simple config-based switcher)"
    echo -e "  ${BOLD}3)${NC} Configure with ${BOLD}optimus-manager${NC} (AMD not supported)"
    echo
    echo -e "  ${PURPLE}--- Legacy/Advanced Methods ---${NC}"
    echo -e "  ${BOLD}4)${NC} ${ICON_LEGACY} Use ${BOLD}bbswitch${NC} to force power off (Older GPUs only)"
    # Awaiting a safer implementation of acpi_call; omitting from menu for now.
    echo
    echo -e "  ${PURPLE}--- Diagnostics & Information ---${NC}"
    echo -e "  ${BOLD}8)${NC} ${ICON_INFO} Explain how NVIDIA power management works on ${BOLD}Wayland${NC}"
    echo -e "  ${BOLD}9)${NC} ${ICON_TOOL} Full System & GPU Power Status Check"
    echo
    echo -e "  ${BOLD}q)${NC} Exit"
    echo
}

main() {
    check_root
    get_system_info

    while true; do
        show_menu
        read -p "Enter your choice: " choice

        case $choice in
            0) nvidia_d3_pm_method ;;
            1) supergfxctl_method ;;
            2) envycontrol_method ;;
            3) optimus_manager_method ;;
            4) bbswitch_method ;;
            8) wayland_explanation ;;
            9) check_status ;;
            q|Q) print_info "Exiting..."; exit 0 ;;
            *) print_error "Invalid option. Please choose from the menu." ;;
        esac

        echo
        read -p "Press Enter to return to the menu..."
    done
}

# Run main function
main
