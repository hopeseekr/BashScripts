#!/usr/bin/env bash
#########################################################################
# tar-stats: A 'tar' Wrapper for Creation and Extraction                #
#                                                                       #
# A transparent wrapper for 'tar' to add progress bars for both creating#
# and extracting archives.                                              #
#                                                                       #
# This script intercepts 'tar' commands to provide progress bars using  #
# 'pv' (Pipe Viewer), without changing the original 'tar' command       #
# syntax. It is fully portable and handles tar's flexible argument      #
# style, including the traditional dash-less format (e.g., 'tar cvf').  #
#                                                                       #
# Part of HopeSeekr's BashScripts Collection                            #
# https://github.com/hopeseekr/BashScripts/                             #
#                                                                       #
# Author: HopeSeekr/GPT-4                                               #
# License: MIT License                                                  #
#########################################################################

set -o pipefail

# --- Help/Usage Function (unchanged) ---
show_help() {
  cat << EOF
Usage: $(basename "$0") [MODE] [OPTIONS] <archive-name> [files-or-dirs...]

A transparent wrapper for 'tar' that enhances archive creation (-c) and
extraction (-x) with progress bars using 'pv'. It accepts the same arguments
as 'tar', including the traditional dash-less style.

MODE (must be specified):
  -c, --create        Create a new archive.
  -x, --extract       Extract files from an archive.

COMMON OPTIONS:
  -f, --file          Required. The name of the archive file.
  -v, --verbose       List files as they are processed.
  -C, --directory     For extraction, change to this directory first.
  -z, -j, -J, -a      Compression flags (optional for extraction).

CREATION EXAMPLES:
  # Create a gzipped archive with progress
  $(basename "$0") -czvf my_app.tar.gz ./my_app

  # Use dash-less style with xz compression
  $(basename "$0") cJvf backup.tar.xz /var/www

EXTRACTION EXAMPLES:
  # Extract an archive with progress
  $(basename "$0") -xvf my_app.tar.gz

  # Extract to a specific directory
  $(basename "$0") xvf backup.tar.xz -C /tmp/restore
EOF
}

# --- Shared Parsing and Execution Logic ---

# A robust function to parse all arguments, identify key info,
# and separate passthrough options from controlled ones.
parse_args() {
  # These variables are made global-like to be accessible by the caller
  # Reset them for each call
  archive_name=""
  passthrough_opts=()
  input_paths=()
  all_opts_str=""
  local has_file_flag=0
  local next_arg_is_file=0
  local next_arg_is_dir=0

  for arg in "$@"; do
    all_opts_str+=" $arg"

    if [[ $next_arg_is_file -eq 1 ]]; then
      archive_name="$arg"
      next_arg_is_file=0
      continue
    fi
    if [[ $next_arg_is_dir -eq 1 ]]; then
      passthrough_opts+=("$arg")
      next_arg_is_dir=0
      continue
    fi

    case "$arg" in
      # Controlled flags: We note them but don't pass them through directly
      --create|--extract) ;;
      --file) has_file_flag=1; next_arg_is_file=1 ;;
      --file=*) has_file_flag=1; archive_name="${arg#*=}" ;;

      # Passthrough flags that take an argument
      -C|--directory) passthrough_opts+=("$arg"); next_arg_is_dir=1 ;;

      # Combined or standalone option blocks
      -*)
        local options="${arg#-}"
        if [[ "$options" =~ f ]]; then has_file_flag=1; next_arg_is_file=1; fi
        # Add the entire block to passthrough; we will filter it later
        passthrough_opts+=("$arg")
        ;;

      # Dash-less options or input paths
      *)
        if [[ ${#input_paths[@]} -eq 0 && "$arg" =~ ^[a-zA-Z]+$ ]]; then
          if [[ "$arg" =~ f ]]; then has_file_flag=1; next_arg_is_file=1; fi
          passthrough_opts+=("$arg")
        else
          input_paths+=("$arg")
        fi
        ;;
    esac
  done

  # Final validation
  if [[ $has_file_flag -eq 0 || -z "$archive_name" ]]; then
    echo "Error: The file flag (-f or --file) and an archive name are required." >&2
    return 1
  fi
}

# This function cleans the collected options, removing mode/file flags
# so they don't conflict with our manually added ones.
build_final_opts() {
  local -a final_opts=()
  for opt in "${passthrough_opts[@]}"; do
      # Remove mode/file flags from the options we pass to tar
      # This prevents duplicates with our controlled '-c', '-x', and '-f -'
      if [[ "$opt" =~ ^-- ]]; then
          [[ "$opt" != "--create" && "$opt" != "--extract" && "$opt" != "--file" && ! "$opt" =~ ^--file= ]] && final_opts+=("$opt")
      else
          # For short/dashless options, strip the controlled characters
          local cleaned_opt
          cleaned_opt=$(echo "$opt" | tr -d 'cxf')
          # If anything is left (like 'v', 'z'), add it back with a dash
          [[ -n "$cleaned_opt" ]] && final_opts+=("-$cleaned_opt")
      fi
  done
  # Return the cleaned options as a string
  echo "${final_opts[*]}"
}

# --- Handler for Creating Archives ---
handle_create() {
  parse_args "$@" || exit 1
  local final_opts
  final_opts=$(build_final_opts)

  # Validation
  if [[ ${#input_paths[@]} -eq 0 ]]; then
    echo "Error (Create): At least one input file/directory is required." >&2; exit 1;
  fi
  for path in "${input_paths[@]}"; do
    if [[ ! -e "$path" ]]; then echo "Error: Input path does not exist: '$path'" >&2; exit 1; fi
  done

  # Determine Compressor
  local compressor_cmd="cat"; local compressor_name="None"
  if [[ "$all_opts_str" =~ (--gzip|-z|z) ]]; then compressor_cmd="gzip"; compressor_name="Gzip";
  elif [[ "$all_opts_str" =~ (--bzip2|-j|j) ]]; then compressor_cmd="bzip2"; compressor_name="Bzip2";
  elif [[ "$all_opts_str" =~ (--xz|-J|J) ]]; then compressor_cmd="xz -T0 -c"; compressor_name="XZ";
  elif [[ "$all_opts_str" =~ (--zstd|-Z) ]]; then compressor_cmd="zstd"; compressor_name="Zstd";
  elif [[ "$all_opts_str" =~ (--auto-compress|-a|a) ]]; then
    case "$archive_name" in
      *.tar.gz|*.tgz) compressor_cmd="gzip"; compressor_name="Gzip";;
      *.tar.bz2|*.tbz2) compressor_cmd="bzip2"; compressor_name="Bzip2";;
      *.tar.xz|*.txz) compressor_cmd="xz -T0 -c"; compressor_name="XZ";;
      *.tar.zst|*.tzst) compressor_cmd="zstd"; compressor_name="Zstd";;
      *) echo "Warning: -a specified but couldn't guess compressor for '$archive_name'.";;
    esac
  fi

  # Calculate size and Execute
  echo "Calculating total size of input files..."
  local total_size
  total_size=$(du -sbc "${input_paths[@]}" | tail -n 1 | awk '{print $1}')
  if ! [[ "$total_size" =~ ^[0-9]+$ ]] || [[ "$total_size" -eq 0 ]]; then
      echo "Error: Could not calculate total size or input is empty." >&2; exit 1
  fi

  echo "Starting archive creation... (Destination: ${archive_name})"
  echo "--------------------------------------------------------"

  # The key change is here: We build the command with our controlled flags
  # shellcheck disable=SC2086
  tar -c ${final_opts} -f - "${input_paths[@]}" | \
    pv -c -N "Input (tar)" -s "$total_size" | \
    ${compressor_cmd} | \
    pv -c -N "Output (${compressor_name})" > "${archive_name}"

  # ... (Success/Error messaging remains the same) ...
}

# --- Handler for Extracting Archives ---
handle_extract() {
  parse_args "$@" || exit 1
  local final_opts
  final_opts=$(build_final_opts)

  # Validation
  if [[ ! -f "$archive_name" ]]; then
    echo "Error: Archive file not found: '$archive_name'" >&2; exit 1;
  fi

  # Get archive size and Execute
  local archive_size
  archive_size=$(stat -c %s "${archive_name}" 2>/dev/null || stat -f %z "${archive_name}" 2>/dev/null)

  echo "Starting archive extraction... (Source: ${archive_name})"
  echo "--------------------------------------------------------"

  # The key change is here as well. Note the final array is 'input_paths'
  # which now holds specific files to extract from the archive, if any.
  pv -c -N "Extracting" -s "$archive_size" "$archive_name" | \
    tar -x ${final_opts} -f - "${input_paths[@]}"

  # ... (Success/Error messaging remains the same) ...
}

# --- Main Dispatcher (Unchanged) ---
main() {
  if [[ $# -eq 0 || " $* " =~ (--help|-h) ]]; then show_help; exit 0; fi

  local mode=""
  local all_opts_str="${*}"
  local first_arg="$1"

  if [[ "$all_opts_str" =~ --create || "$all_opts_str" =~ -c || "$first_arg" =~ ^c ]]; then
    mode="create"
  fi
  if [[ "$all_opts_str" =~ --extract || "$all_opts_str" =~ -x || "$first_arg" =~ ^x ]]; then
    if [[ -n "$mode" ]]; then mode="conflict"; else mode="extract"; fi
  fi

  case "$mode" in
    create)  handle_create "$@" ;;
    extract) handle_extract "$@" ;;
    conflict) echo "Error: Cannot specify both create (-c) and extract (-x)." >&2; exit 1 ;;
    *) echo "Error: Must specify a mode: -c (create) or -x (extract)." >&2; show_help; exit 1 ;;
  esac
}

main "$@"
