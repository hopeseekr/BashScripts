#!/usr/bin/env bash
#########################################################################
# tar-stats: A 'tar' Wrapper for Progress Bars                          #
#                                                                       #
# A transparent wrapper for 'tar' to add progress bars for creation.    #
#                                                                       #
# This script intercepts 'tar' creation commands to provide dual        #
# progress bars using 'pv' (Pipe Viewer), without changing the          #
# original 'tar' command syntax. It is designed to be fully portable    #
# and handle tar's flexible argument style, including the traditional   #
# dash-less format (e.g., 'tar cvf ...').                               #
#                                                                       #
# Part of HopeSeekr's BashScripts Collection                            #
# https://github.com/hopeseekr/BashScripts/                             #
#                                                                       #
# License: CC BY 4.0                                                    #
#########################################################################

# Exit immediately if a command in a pipeline fails.
set -o pipefail

# --- Help/Usage Function ---
show_help() {
  cat << EOF
Usage: $(basename "$0") -c [OPTIONS] -f <archive-name> <file1> [file2] ...
       $(basename "$0") c[OPTIONS]f <archive-name> <file1> [file2] ...

A transparent wrapper for 'tar' that enhances archive creation (-c) with
progress bars. It accepts the same arguments as 'tar' for creation, including
the traditional dash-less style (e.g., 'cvf').

The script works by parsing 'tar' arguments, calculating the total size of
input files for an accurate progress bar, and then constructing a pipe:
  tar | pv (input) | compressor | pv (output) > archive_file

SUPPORTED TAR FLAGS:
  -c, --create        Required. Specifies that an archive should be created.
  -f, --file          Required. The name of the archive file to be created.
  -z, --gzip
  -j, --bzip2
  -J, --xz
  -a, --auto-compress   Selects compression based on the archive file extension.
  -v, --verbose         Is passed to 'tar' to list files as they are processed.
  ... and other valid tar flags are passed through.

EXAMPLES:
  # Same as 'tar -czvf my_app.tar.gz ./my_app'
  $(basename "$0") -czvf my_app.tar.gz ./my_app

  # Use the traditional dash-less style with xz compression
  $(basename "$0") cJvf backup.tar.xz /var/www

  # Create an uncompressed archive with long options
  $(basename "$0") --create --file=data.tar /path/to/data
EOF
}

# --- Main Script Logic ---
main() {
  # --- Step 1: Initial checks and argument parsing ---
  if [[ $# -eq 0 ]]; then show_help; exit 1; fi
  if [[ " $* " =~ (--help|-h) ]]; then show_help; exit 0; fi

  local -a all_args=("$@")
  local -a tar_passthrough_opts=()
  local -a input_paths=()

  local archive_name=""
  local compressor_cmd="cat"
  local compressor_name="None"
  local is_create=0
  local has_file_flag=0
  local next_arg_is_file=0

  for arg in "${all_args[@]}"; do
    if [[ $next_arg_is_file -eq 1 ]]; then
      archive_name="$arg"
      next_arg_is_file=0
      continue
    fi

    # Check for option-like arguments (e.g., -czf, czf, --create, --file=...)
    case "$arg" in
      # Handle long options
      --create) is_create=1; tar_passthrough_opts+=("$arg");;
      --file=*)
        has_file_flag=1
        archive_name="${arg#*=}"
        # Do NOT add to passthrough_opts, we handle file output manually
        ;;
      --file)
        has_file_flag=1
        next_arg_is_file=1
        # Do NOT add to passthrough_opts
        ;;
      --gzip|--bzip2|--xz|--zstd|--auto-compress)
        tar_passthrough_opts+=("$arg")
        ;;

      # Handle short options, with or without a leading dash
      -*)
        # It's a dashed block like -czf or -c
        local options="${arg#-}"
        if [[ "$options" =~ c ]]; then is_create=1; fi
        if [[ "$options" =~ f ]]; then
          has_file_flag=1
          next_arg_is_file=1
        fi
        tar_passthrough_opts+=("$arg")
        ;;

      # This case handles dash-less options (e.g. 'czf') AND input paths
      *)
        # Check if it's a plausible dash-less option block
        # It must come before any input paths have been identified.
        if [[ ${#input_paths[@]} -eq 0 && "$arg" =~ ^[a-zA-Z]+$ ]]; then
          if [[ "$arg" =~ c ]]; then is_create=1; fi
          if [[ "$arg" =~ f ]]; then
            has_file_flag=1
            next_arg_is_file=1
          fi
          tar_passthrough_opts+=("$arg")
        else
          # It's an input path
          input_paths+=("$arg")
        fi
        ;;
    esac
  done

  # --- Step 2: Validation ---
  if [[ $is_create -eq 0 || $has_file_flag -eq 0 || -z "$archive_name" ]]; then
    echo "Error: Must specify creation ('-c' or 'c'), file ('-f' or 'f'), and an archive name." >&2
    show_help
    exit 1
  fi
  if [[ ${#input_paths[@]} -eq 0 ]]; then
    echo "Error: No input files or directories specified." >&2
    exit 1
  fi
  for path in "${input_paths[@]}"; do
    if [[ ! -e "$path" ]]; then echo "Error: Input path does not exist: '$path'" >&2; exit 1; fi
  done

  # --- Step 3: Determine Compressor from all identified options ---
  local all_opts_str="${tar_passthrough_opts[*]}"
  if [[ "$all_opts_str" =~ (--gzip|-z|z) ]]; then compressor_cmd="gzip"; compressor_name="Gzip";
  elif [[ "$all_opts_str" =~ (--bzip2|-j|j) ]]; then compressor_cmd="bzip2"; compressor_name="Bzip2";
  elif [[ "$all_opts_str" =~ (--xz|-J|J) ]]; then compressor_cmd="xz -T0 -c"; compressor_name="XZ";
  elif [[ "$all_opts_str" =~ (--zstd|-Z) ]]; then compressor_cmd="zstd"; compressor_name="Zstd";
  elif [[ "$all_opts_str" =~ (--auto-compress|-a|a) ]]; then
    case "$archive_name" in
      *.tar.gz|*.tgz) compressor_cmd="gzip"; compressor_name="Gzip";;
      *.tar.bz2|*.tbz2) compressor_cmd="bzip2"; compressor_name="Bzip2";;
      *.tar.xz|*.txz) compressor_cmd="xz -T0 -c"; compressor_name="XZ";;
      *.tar.zst|*.tzst) compressor_cmd="zstd"; compressor_name="Zstd";;
      *) echo "Warning: -a specified but couldn't guess compressor for '$archive_name'. Creating uncompressed tar.";;
    esac
  fi

  # --- Step 4: Dependency Checks ---
  local deps=("tar" "pv")
  if [[ "$compressor_cmd" != "cat" ]]; then deps+=("${compressor_cmd%% *}"); fi
  for dep in "${deps[@]}"; do
    if ! command -v "$dep" &> /dev/null; then echo "Error: Required command '$dep' is not installed." >&2; exit 1; fi
  done

  # --- Step 5: Calculate size and Execute ---
  echo "Calculating total size... (this may take a moment)"
  local total_size
  total_size=$(du -sbc "${input_paths[@]}" | tail -n 1 | awk '{print $1}')
  if ! [[ "$total_size" =~ ^[0-9]+$ ]] || [[ "$total_size" -eq 0 ]]; then
      echo "Error: Could not calculate total size or input is empty." >&2; exit 1
  fi

  echo "Starting archive creation..."
  echo "  - Destination: ${archive_name}"
  echo "  - Compression: ${compressor_name}"
  echo "--------------------------------------------------------"

  # The Pipeline:
  # - Pass all identified tar options, but force output to stdout (-f -)
  # - The rest of the pipeline handles compression and file output.
  tar "${tar_passthrough_opts[@]}" -f - "${input_paths[@]}" | \
    pv -c -N "Input (tar)" -s "$total_size" | \
    ${compressor_cmd} | \
    pv -c -N "Output (${compressor_name})" > "${archive_name}"

  local exit_code=$?
  echo "--------------------------------------------------------"
  if [[ $exit_code -eq 0 ]]; then
    local final_size
    final_size=$(stat -c %s "${archive_name}" 2>/dev/null || stat -f %z "${archive_name}" 2>/dev/null) # Linux || macOS
    echo "✅ Success: Archive created at '${archive_name}'"
    echo "   Final Size: $(numfmt --to=iec-i --suffix=B --format="%.2f" "$final_size" 2>/dev/null || echo "${final_size} bytes")"
  else
    echo "❌ Error: Archiving failed. Cleaning up incomplete file." >&2
    rm -f "${archive_name}"
    exit 1
  fi
}

# Execute the main function, passing all script arguments to it.
main "$@"
