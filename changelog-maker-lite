#!/usr/bin/env bash
### ==== changelog-maker-lite ====
#########################################################################
# ChangeLog Maker (lite)                                                #
#                                                                       #
#   Quickly creates CHANGELOG.md entries suitable for GitHub from       #
#   the repo's commit log.                                              #
#                                                                       #
#   It expects to be passed a git revision range, typically             #
#   'LAST_VERSION..' to get all commits since LAST_VERSION,             #
#   or 'FIRST_VERSION..LAST_VERSION' for a specific range.             #
#   If no argument is provided, it will generate a changelog for        #
#   ALL commits in the repository.                                      #
#                                                                       #
# Part of HopeSeekr's BashScripts Collection                            #
# https://github.com/hopeseekr/BashScripts/                             #
#                                                                       #
# Copyright © 2020 Theodore R. Smith <theodore@phpexperts.pro>          #
# GPG Fingerprint: 4BF8 2613 1C34 87AC D28F  2AD8 EB24 A91D D612 5690   #
#                                                                       #
# License: Creative Commons Attribution v4.0 International              #
#########################################################################

# Determine the git log range.
range="${1:-$(git rev-list --max-parents=0 HEAD 2>/dev/null)..HEAD}"

# Use a hybrid approach for maximum reliability:
# 1. `git log` formats the date/time string to avoid using `cut`.
# 2. It also provides the Unix epoch timestamp (%at).
# 3. A loop processes each line, using the reliable `date` command to get
#    the timezone abbreviation from the epoch timestamp.
# This avoids the non-portable behavior of `%Z` inside `git log`.

git log --date=format:'%Y-%m-%d %H:%M:%S' \
    --pretty=format:'%at|%ad|%s' "$range" | \
while IFS='|' read -r epoch datetime subject || [[ -n "$subject" ]]; do
    # Skip potentially empty lines from git log's output
    if [[ -z "$epoch" ]]; then continue; fi

    tz_abbr=$(date -d "@$epoch" +"%Z")
    echo "* **[$datetime $tz_abbr]** $subject"
done
